  <visual>
    <headlight ambient="0.25 0.25 0.25" diffuse="0.45 0.45 0.45" specular="0.2 0.2 0.2"/>
    <rgba haze="0.75 0.8 0.85 1"/>
    <global offwidth="1280" offheight="720"/>
  </visual>
  <statistic center="0 0 0.9" extent="1.8"/>
  <asset>
    <texture name="scene_sky" type="skybox" builtin="gradient" rgb1="0.65 0.75 0.85" rgb2="0.95 0.95 0.95" width="512" height="3072"/>
    <texture name="scene_floor" type="2d" builtin="checker" rgb1="0.3 0.33 0.36" rgb2="0.4 0.43 0.46" width="512" height="512"/>
    <material name="scene_floor" texture="scene_floor" texrepeat="4 4" texuniform="true" reflectance="0.05"/>
  </asset>
  <worldbody>
    <light name="scene_key" pos="2 -2 3" dir="-0.5 0.5 -1" directional="true" diffuse="0.45 0.45 0.45" specular="0.2 0.2 0.2"/>
    <light name="scene_fill" pos="-2 2 2.5" dir="0.5 -0.5 -1" directional="true" diffuse="0.2 0.2 0.2" castshadow="false"/>
    <geom name="scene_floor" type="plane" size="0 0 0.05" material="scene_floor" contype="0" conaffinity="0"/>
  </worldbody>
</mujoco>
